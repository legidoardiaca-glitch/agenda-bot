# Token del bot, te lo da @BotFather en Telegram al crear el bot con /newbot
TELEGRAM_BOT_TOKEN=

# Zona horaria del usuario (afecta a cómo se interpretan y muestran las horas)
TZ=Europe/Madrid

# Perfil de desplazamiento usado para calcular tiempo/distancia con OSRM.
# El servidor público de OSRM solo soporta "driving" (coche).
TRAVEL_PROFILE=driving

# Opcional: base de datos persistente en Turso (turso.tech). Si se dejan
# vacías, se usa un archivo SQLite local (data/agenda.db) — válido para
# probar en tu ordenador, pero se borra en plataformas sin disco persistente
# como el plan gratuito de Render. Ver README, sección "Turso".
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
